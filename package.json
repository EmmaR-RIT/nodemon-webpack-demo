{
  "name": "simple_http",
  "version": "0.0.0",
  "description": "A simple HTTP example using status codes",
  "main": "./src/server.js",
  "scripts": {
    "start": "node ./src/server.js",
    "pretest": "eslint ./src --fix",
    "test": "echo \"Tests complete\"",
    "nodemon": "nodemon -e js,html,css --watch ./src --watch ./hosted ./src/server.js",
    "build": "webpack",
    "build-dev": "webpack --mode development",
    "watch": "webpack watch",
    "dev": "concurrently \"npm run nodemon\" \"npm run watch\""
  },
  "author": "Austin Willoughby",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.0.0",
    "globals": "^17.3.0",
    "nodemon": "^3.1.14",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  }
}
